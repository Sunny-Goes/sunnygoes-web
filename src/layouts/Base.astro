---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${site.name} · autonomous vulnerability research`,
  description = site.tagline,
  ogImage = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} · notes`} href={site.rss} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- mobile nav ---
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.querySelector<HTMLElement>('.site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav!.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') {
          nav.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
        }
      });

      // --- scroll reveal (once, subtle) ---
      const revealEls = document.querySelectorAll('.reveal');
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('in'));
      }

      // --- defense pipeline: hover/focus a stage to read what it does ---
      const pipeline = document.querySelector<HTMLElement>('[data-pipeline]');
      if (pipeline) {
        const panel = pipeline.querySelector<HTMLElement>('[data-pipeline-panel]');
        const stages = Array.from(pipeline.querySelectorAll<HTMLElement>('[data-stage]'));
        const fallback = panel?.textContent ?? '';
        let activeStage: string | null = null;
        const activate = (id: string | null) => {
          if (id === activeStage) return;
          activeStage = id;
          pipeline.querySelectorAll('.is-active').forEach((el) => el.classList.remove('is-active'));
          if (id && panel) {
            pipeline
              .querySelectorAll(`[data-stage="${id}"], [data-stages~="${id}"]`)
              .forEach((el) => el.classList.add('is-active'));
            const blurb = stages.find((s) => s.dataset.stage === id)?.dataset.blurb;
            if (blurb) panel.textContent = blurb;
          } else if (panel) {
            panel.textContent = fallback;
          }
        };
        stages.forEach((s) => {
          s.addEventListener('mouseenter', () => activate(s.dataset.stage ?? null));
          s.addEventListener('focus', () => activate(s.dataset.stage ?? null));
          s.addEventListener('mouseleave', () => activate(null));
          s.addEventListener('blur', () => activate(null));
        });
      }

      // --- defense deck: prev/next buttons, dots, counter ---
      const deck = document.querySelector<HTMLElement>('[data-deck]');
      if (deck) {
        const track = deck.querySelector<HTMLElement>('.deck__track')!;
        const slides = Array.from(track.querySelectorAll<HTMLElement>('.deck__slide'));
        const dots = Array.from(deck.querySelectorAll<HTMLButtonElement>('[data-deck-dot]'));
        const count = deck.querySelector<HTMLElement>('[data-deck-count]');
        const prev = deck.querySelector<HTMLButtonElement>('[data-deck-prev]');
        const next = deck.querySelector<HTMLButtonElement>('[data-deck-next]');
        let currentSlide = 0;
        const go = (i: number) => {
          const clamped = Math.max(0, Math.min(i, slides.length - 1));
          track.scrollTo({
            left: slides[clamped].offsetLeft,
            behavior: reduced ? 'auto' : 'smooth',
          });
        };
        const sync = () => {
          const left = track.scrollLeft;
          let best = 0;
          let bestDist = Infinity;
          slides.forEach((s, i) => {
            const d = Math.abs(s.offsetLeft - left);
            if (d < bestDist) {
              bestDist = d;
              best = i;
            }
          });
          currentSlide = best;
          dots.forEach((d, i) => d.setAttribute('aria-current', String(i === currentSlide)));
          if (count) count.textContent = `${currentSlide + 1} / ${slides.length}`;
        };
        prev?.addEventListener('click', () => go(currentSlide - 1));
        next?.addEventListener('click', () => go(currentSlide + 1));
        dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
        let ticking = false;
        track.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(() => {
                sync();
                ticking = false;
              });
            }
          },
          { passive: true }
        );
        sync();
      }
    </script>
  </body>
</html>
