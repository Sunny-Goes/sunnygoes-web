---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteRow from '../../components/NoteRow.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Notes · Sunny Goes" description="The Sunny Goes research feed: reverse-chronological notes on AI and security research.">
  <section class="section">
    <div class="container">
      <div class="sec-head reveal">
        <div class="sec-head__row">
          <span class="sec-head__num">02</span>
          <h1 class="sec-head__title">Notes · all entries</h1>
        </div>
        <p class="sec-head__desc">
          Every research note we've published, newest first.
        </p>
      </div>

      <div class="notes-list">
        {notes.map((note) => <NoteRow note={note} />)}
      </div>
    </div>
  </section>
</Base>
